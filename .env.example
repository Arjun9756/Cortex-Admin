# Database Configuration (TiDB Cloud / MySQL)
DATABASE_SQL_HOST=
DATABASE_SQL_PORT=4000
DATABASE_SQL_USER=
DATABASE_SQL_PASSWORD=
DATABASE_SQL_DATABASE=cortex_admin

# Server & Security
PORT=5000
JWT_SECRET=
COOKIE_SECRET=
COOKIE_EXPIRY_DAYS=7

# Licensing Rules
DEFAULT_LICENSE_VALIDITY_DAYS=264    # 264 DAYS FREE TRIAL
LICENSE_PING_INTERVAL_HOURS=6        # PING INTERVAL FOR LICENSE VALIDITY

# Admin Credentials
ADMIN_DEFAULT_EMAIL=admin@cortexco.com
ADMIN_DEFAULT_PASSWORD=

# Public Canonical URL of Cortex Admin (For OAuth Callbacks)
ADMIN_PUBLIC_URL=https://admin.cortexco.in

# GitHub App Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack App Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Atlassian Jira OAuth (3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Resend Email Integration
RESEND_API_KEY=
RESEND_BROADCAST_FROM=CortexCo <notification@cortexco.in>
RESEND_SUPPORT_FROM=CortexCo Support <support@cortexco.in>
